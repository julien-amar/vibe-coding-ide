{
  "name": "vibe-coding-ide",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @vibe-coding-ide/desktop dev",
    "build": "pnpm --filter @vibe-coding-ide/desktop build",
    "start": "pnpm --filter @vibe-coding-ide/desktop start",
    "typecheck": "pnpm --filter @vibe-coding-ide/desktop typecheck",
    "lint": "pnpm --filter @vibe-coding-ide/desktop lint",
    "format": "pnpm --filter @vibe-coding-ide/desktop format",
    "format:check": "pnpm --filter @vibe-coding-ide/desktop format:check",
    "ensure-electron": "node -e \"require('fs').existsSync('node_modules/electron/dist')||require('child_process').execSync('node node_modules/electron/install.js',{stdio:'inherit'})\"",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "pnpm --filter @vibe-coding-ide/desktop test",
    "test:e2e": "pnpm --filter @vibe-coding-ide/desktop test:e2e"
  },
  "packageManager": "pnpm@12.16.1"
}
