{
  "name": "@vibe-coding-ide/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "vibe-coding-ide - a tabbed development environment",
  "license": "MIT",
  "main": "out/main/index.js",
  "desktopName": "vibe-coding-ide.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json --max-warnings 0 src e2e scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --publish never",
    "release:build": "node scripts/release-build.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jest": "^30.5.2",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "author": {
    "name": "julien-amar",
    "email": "julien-amar@users.noreply.github.com"
  },
  "homepage": "https://github.com/julien-amar/vibe-coding-ide",
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-amar/vibe-coding-ide.git"
  }
}
